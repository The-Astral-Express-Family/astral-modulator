!go.mod
!**/go.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# ---- Go server ----
server/astral-server
server/astral-server.exe
server/*.test
server/coverage.out

# ---- Web ----
web/node_modules/
web/dist/
web/*.local

# ---- env / secrets（凭证只进系统 Credential Store 或 secret manager）----
.env
.env.*
!.env.example

# ---- editors/tooling ----
.idea/
.vscode/
redocly.ignore

# ---- TS build cache ----
*.tsbuildinfo
