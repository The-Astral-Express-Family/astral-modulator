# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod
# Go module 文件必须入库（上面的 *.mod 会误伤 go.mod）
!go.mod
!**/go.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
# server/Makefile 是手写构建辅助（round 38 S6-1），非 CMake 生成物，需入库
!server/Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# ---- Go server ----
server/astral-server
server/astral-server.exe
server/*.test
server/coverage.out
# webdist 构建产物（make web-dist 拷入；.gitkeep 占位必须入库，勿删）
server/webdist/dist/*
!server/webdist/dist/.gitkeep

# ---- Web ----
web/node_modules/
web/dist/
web/*.local

# ---- env / secrets（凭证只进系统 Credential Store 或 secret manager）----
.env
.env.*
!.env.example

# ---- editors/tooling ----
.idea/
.vscode/
redocly.ignore
.v2c/

# ---- TS build cache ----
*.tsbuildinfo

# ---- agent skills ----
# 真身在 .agents/skills/（入库，pi/zcode 直接扫）；.claude 下是给 Claude Code 的本机符号链接
.claude/skills/repo-hygiene
