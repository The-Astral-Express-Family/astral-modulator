# astral-server 本地开发配置模板。
# 复制为 server/.env 后按需修改；.env / .env.* 已被 .gitignore 忽略，
# 严禁提交真实凭证（secrets 只允许留在本地 / Credential Store / secret manager）。
# 完整变量说明见 server/internal/config/config.go 与 README「主要环境变量」。

# HTTP 监听地址（默认 :8080，web 开发代理指向 127.0.0.1:8080）
ASTRAL_HTTP_ADDR=:8080

# canonical URL，写入 /.well-known/astral；留空时回退为请求 Host
#ASTRAL_PUBLIC_URL=

# PostgreSQL 连接串；留空 = 桩模式（受保护端点 401 / readyz 503）
ASTRAL_DATABASE_DSN=postgres://astral:astral@localhost:5433/astral?sslmode=disable

# 稳定服务器身份；仅在首启时生效，之后以 server_meta 表中值为准
ASTRAL_SERVER_ID=srv_dev_local

# 启动时自动 goose up（生产多实例部署必须关闭）
ASTRAL_AUTO_MIGRATE=true

# 开发期浏览器跨域白名单（逗号分隔，如 http://localhost:5173）；同源部署留空
#ASTRAL_DEV_CORS_ORIGINS=

# 日志级别：debug / info（默认）/ warn / error
#ASTRAL_LOG_LEVEL=info
